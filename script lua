	-- ---------- Loop: plataforma infinita + "no bajas" ----------
	local function subidaIniciarLoop()
		if subidaLoopConn then return end
		subidaLoopConn = RunService.Stepped:Connect(function()
			if not subidaActiva or not subidaPisoY or subidaSuspendida > 0 then return end
			local hrp = subidaHRP()
			if not hrp then return end

			-- La plataforma te sigue al caminar -> infinita
			if subidaPlataforma and subidaPlataforma.Parent then
				local pp = subidaPlataforma.Position
				local hp = hrp.Position
				local dx, dz = pp.X - hp.X, pp.Z - hp.Z
				if dx * dx + dz * dz > 4 then
					subidaPlataforma.CFrame = CFrame.new(hp.X, subidaPisoY - 0.5, hp.Z)
				end
			end

			-- Nunca por debajo del nivel alcanzado
			if hrp.Position.Y < subidaPisoY then
				local velY = math.max(hrp.AssemblyLinearVelocity.Y, 0)
				hrp.CFrame = CFrame.new(hrp.Position.X, subidaPisoY, hrp.Position.Z) * hrp.CFrame.Rotation
				hrp.AssemblyLinearVelocity = Vector3.new(
					hrp.AssemblyLinearVelocity.X, velY, hrp.AssemblyLinearVelocity.Z
				)
				hrp.AssemblyAngularVelocity = Vector3.zero
			end
		end)
	end

	local function subidaDetenerLoop()
		if subidaLoopConn then
			pcall(function() subidaLoopConn:Disconnect() end)
			subidaLoopConn = nil
		end
	end

	-- ---------- Subida suave ----------
	local function subirSuave()
		if subidaSubiendo or subidaSuspendida > 0 then return end
		local hrp = subidaHRP()
		if not hrp then return end
		subidaSubiendo = true

		-- Nivel monotónico: subes pero no bajas, aunque el terreno baje.
		local nivel = subidaPisoReal(hrp.Position) + SUBIDA_ALTURA
		if subidaPisoY and nivel < subidaPisoY then nivel = subidaPisoY end
		subidaPisoY = nivel
		local yDestino = subidaPisoY + SUBIDA_OFFSET_PIES

		subidaCrearPlataforma(hrp.Position.X, hrp.Position.Z, subidaPisoY - 0.5)

		local inicio = hrp.Position
		local destino = Vector3.new(inicio.X, yDestino, inicio.Z)
		local rotacion = hrp.CFrame.Rotation
		local t0 = os.clock()

		pcall(function()
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end)

		while subidaSubiendo do
			local t = math.clamp((os.clock() - t0) / SUBIDA_TIME, 0, 1)
			local ease = t * t * (3 - 2 * t)
			local pos = inicio:Lerp(destino, ease)

			pcall(function()
				hrp.CFrame = CFrame.new(pos) * rotacion
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
			end)

			if t >= 1 then break end
			RunService.Heartbeat:Wait()
		end

		if subidaSubiendo then
			-- Llegó arriba: asentar la posición y activar plataforma + clamp.
			if hrp and hrp.Parent then
				pcall(function()
					hrp.CFrame = CFrame.new(destino) * rotacion
					hrp.AssemblyLinearVelocity = Vector3.zero
					hrp.AssemblyAngularVelocity = Vector3.zero
				end)
			end
			subidaIniciarLoop()
			print(string.format("[Subida] Piso %.1f -> Plat %.1f (%.3fs)", subidaPisoReal(inicio), subidaPisoY, SUBIDA_TIME))
		end
		-- Si lo cancelaron a mitad (P o el botón), no se sube ni se activa nada.
		subidaSubiendo = false
	end

