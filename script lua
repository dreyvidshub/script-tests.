		Aplicar["Optimizer"] = function(on)
			if on then
				OptimizadorActivo = true
				pcall(function()
					optimizadorGuardado = optimizadorGuardado or {}
					optimizadorGuardado.sombras = optimizadorGuardado.sombras or Lighting.GlobalShadows
					optimizadorGuardado.fogEnd = optimizadorGuardado.fogEnd or Lighting.FogEnd
					optimizadorGuardado.difusa = optimizadorGuardado.difusa or Lighting.EnvironmentDiffuseScale
					optimizadorGuardado.especular = optimizadorGuardado.especular or Lighting.EnvironmentSpecularScale
					optimizadorGuardado.brillo = optimizadorGuardado.brillo or Lighting.Brightness
					Lighting.GlobalShadows = false
					Lighting.FogEnd = 100000
					Lighting.EnvironmentDiffuseScale = 0
					Lighting.EnvironmentSpecularScale = 0
					for _, efecto in ipairs(Lighting:GetChildren()) do
						if efecto:IsA("PostEffect") then
							optimizadorGuardado["efecto_" .. efecto.Name] = optimizadorGuardado["efecto_" .. efecto.Name] ~= nil and optimizadorGuardado["efecto_" .. efecto.Name] or efecto.Enabled
							efecto.Enabled = false
						end
					end
				end)

				pcall(function()
					local terreno = Workspace:FindFirstChildOfClass("Terrain")
					if terreno then
						optimizadorGuardado.aguaOla = optimizadorGuardado.aguaOla or terreno.WaterWaveSize
						optimizadorGuardado.aguaVel = optimizadorGuardado.aguaVel or terreno.WaterWaveSpeed
						optimizadorGuardado.aguaReflejo = optimizadorGuardado.aguaReflejo or terreno.WaterReflectance
						optimizadorGuardado.aguaTransp = optimizadorGuardado.aguaTransp or terreno.WaterTransparency
						terreno.WaterWaveSize = 0
						terreno.WaterWaveSpeed = 0
						terreno.WaterReflectance = 0
						terreno.WaterTransparency = 1
					end
				end)

				local vistos = 0
				local function aligerar(inst)
					vistos = vistos + 1
					if vistos > 4000 then return end
					if optimizadorPartes[inst] ~= nil then return end
					if inst:IsA("MeshPart") then
						optimizadorPartes[inst] = {tipo = "malla", valor = inst.RenderFidelity}
						pcall(function() inst.RenderFidelity = Enum.RenderFidelity.Performance end)
					elseif inst:IsA("BasePart") and inst.CastShadow then
						optimizadorPartes[inst] = {tipo = "sombra", valor = true}
						pcall(function() inst.CastShadow = false end)
					elseif inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Sparkles") then
						optimizadorPartes[inst] = {tipo = "efecto", valor = inst.Enabled}
						pcall(function() inst.Enabled = false end)
					elseif inst:IsA("Texture") or inst:IsA("Decal") then
						optimizadorPartes[inst] = {tipo = "textura", valor = inst.Transparency}
						pcall(function() inst.Transparency = 1 end)
					end
				end

				for _, inst in ipairs(Workspace:GetDescendants()) do
					aligerar(inst)
				end

				if not optimizadorConexion then
					optimizadorConexion = Workspace.DescendantAdded:Connect(function(inst)
						if OptimizadorActivo then
							task.defer(function()
								local ok = pcall(aligerar, inst)
							end)
						end
					end)
				end
			else
				OptimizadorActivo = false
				if optimizadorConexion then
					pcall(function() optimizadorConexion:Disconnect() end)
					optimizadorConexion = nil
				end
				for inst, datos in pairs(optimizadorPartes) do
					if inst and inst.Parent then
						pcall(function()
							if datos.tipo == "malla" then
								inst.RenderFidelity = datos.valor
							elseif datos.tipo == "sombra" then
								inst.CastShadow = datos.valor
							elseif datos.tipo == "efecto" then
								inst.Enabled = datos.valor
							elseif datos.tipo == "textura" then
								inst.Transparency = datos.valor
							end
						end)
					end
				end
				optimizadorPartes = setmetatable({}, {__mode = "k"})
				pcall(function()
					if not optimizadorGuardado then return end
					Lighting.GlobalShadows = optimizadorGuardado.sombras
					Lighting.FogEnd = optimizadorGuardado.fogEnd
					Lighting.EnvironmentDiffuseScale = optimizadorGuardado.difusa
					Lighting.EnvironmentSpecularScale = optimizadorGuardado.especular
					Lighting.Brightness = optimizadorGuardado.brillo
					for _, efecto in ipairs(Lighting:GetChildren()) do
						if efecto:IsA("PostEffect") then
							local original = optimizadorGuardado["efecto_" .. efecto.Name]
							if original ~= nil then efecto.Enabled = original end
						end
					end
					local terreno = Workspace:FindFirstChildOfClass("Terrain")
					if terreno then
						terreno.WaterWaveSize = optimizadorGuardado.aguaOla or 0.15
						terreno.WaterWaveSpeed = optimizadorGuardado.aguaVel or 10
						terreno.WaterReflectance = optimizadorGuardado.aguaReflejo or 0
						terreno.WaterTransparency = optimizadorGuardado.aguaTransp or 1
					end
				end)
				optimizadorGuardado = nil
			end
		end
