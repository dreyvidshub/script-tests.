	-- CAPA DEL JUEGO: huevos reales -> lista de objetivos + agarre
	-- Rutas del juego REAL (sacadas del hub de Chilli, que corre en el juego):
	--   ReplicatedStorage.Client.EggState      -> ReadFieldEggs / CarryFieldEgg /
	--                                             DropFieldEgg / IsReadyToHatch /
	--                                             PlantEgg / WearEggTool
	--   ReplicatedStorage.Data.Assets          -> .Directory[categoria]
	--   ReplicatedStorage.Shared.Save          -> .Get()
	--   ReplicatedStorage.Packages.Networking  -> remotes "RF/..." y "RE/..."
	-- Si alguna no existe, se intenta la ruta del rip moddeado.
	-- =====================================================
	local Juego = nil
	do
		local function intentar(rutas)
			for _, fn in ipairs(rutas) do
				local ok, modulo = pcall(fn)
				if ok and modulo ~= nil then
					return modulo
				end
			end
			return nil
		end

		local EggState = intentar({
			function() return require(ReplicatedStorage.Client.EggState) end,
			function() return require(ReplicatedStorage.Library.Client.EggCmds) end,
		})
		local Assets = intentar({
			function() return require(ReplicatedStorage.Data.Assets) end,
			function() return require(ReplicatedStorage.Directory.Assets) end,
		})
		local Save = intentar({
			function() return require(ReplicatedStorage.Shared.Save) end,
			function() return require(ReplicatedStorage.Library.Client.Save) end,
		})
		local Mutations = intentar({
			function() return require(ReplicatedStorage.Shared.Modules.Mutations) end,
		})
		local Networking = nil
		pcall(function()
			local paquetes = ReplicatedStorage:FindFirstChild("Packages")
			Networking = paquetes and paquetes:FindFirstChild("Networking")
		end)

		local cargados = {}
		if EggState then table.insert(cargados, "EggState") end
		if Assets then table.insert(cargados, "Assets") end
		if Save then table.insert(cargados, "Save") end
		if Mutations then table.insert(cargados, "Mutations") end
		if Networking then table.insert(cargados, "Networking") end

		-- ---------- remotes por nombre (juego real) ----------
		local function Invocar(nombre, ...)
			if not Networking then return nil end
			local remoto = Networking:FindFirstChild(nombre)
			if not remoto or not remoto:IsA("RemoteFunction") then return nil end
			local ok, a = pcall(remoto.InvokeServer, remoto, ...)
			return ok and a or nil
		end

		local function Disparar(nombre, ...)
			if not Networking then return false end
			local remoto = Networking:FindFirstChild(nombre)
			if not remoto or not remoto:IsA("RemoteEvent") then return false end
			return pcall(remoto.FireServer, remoto, ...)
		end

		-- ---------- helpers ----------
		local function FormatoCorto(n)
			if type(n) ~= "number" then return "?" end
			if n >= 1e12 then return string.format("%.2fT", n / 1e12) end
			if n >= 1e9 then return string.format("%.2fB", n / 1e9) end
			if n >= 1e6 then return string.format("%.2fm", n / 1e6) end
			if n >= 1e3 then return string.format("%.1fK", n / 1e3) end
			return tostring(math.floor(n + 0.5))
		end

		local function Crecimiento(escala)
			if escala > 5 then
				return (escala / 5) ^ 1.2 * 19.637875755794113
			end
			return escala ^ 1.85
		end

		local function PosicionDe(registro)
			for _, campo in ipairs({"BottomCFrame", "CFrame", "LocalCFrame", "Position"}) do
				local valor = registro[campo]
				if typeof(valor) == "CFrame" then
					return valor.Position
				elseif typeof(valor) == "Vector3" then
					return valor
				elseif type(valor) == "table" and #valor >= 3 then
					return Vector3.new(tonumber(valor[1]) or 0, tonumber(valor[2]) or 0, tonumber(valor[3]) or 0)
				end
			end
			return nil
		end

		local COLORES = {
			Common = Color3.fromRGB(190, 200, 215), Uncommon = Color3.fromRGB(120, 220, 140),
			Rare = Color3.fromRGB(110, 180, 255), Epic = Color3.fromRGB(190, 130, 255),
			Legendary = Color3.fromRGB(255, 190, 90), Mythic = Color3.fromRGB(255, 120, 120),
			Divine = Color3.fromRGB(255, 240, 160), Secret = Color3.fromRGB(255, 140, 230),
			Spirit = Color3.fromRGB(200, 160, 255), Cosmic = Color3.fromRGB(140, 200, 255),
			Eternal = Color3.fromRGB(180, 255, 230),
		}

		-- ---------- lectura del campo ----------
		local function RegistrosDelCampo()
			if not EggState then return nil, "sin EggState" end

			if type(EggState.ReadFieldEggs) == "function" then
				local ok, res = pcall(EggState.ReadFieldEggs)
				if ok and type(res) == "table" then
					if type(res.Records) == "table" then return res.Records end
					return res
				end
			end

			if type(EggState.RequestAreaEggSnapshot) == "function" then
				pcall(EggState.RequestAreaEggSnapshot)
				local ok, res = pcall(EggState.GetAreaEggSnapshot)
				if ok and type(res) == "table" and type(res.Records) == "table" then
					return res.Records
				end
			end

			return nil, "sin función de lectura"
		end

		local function LeerHuevos()
			local registros, error1 = RegistrosDelCampo()
			if not registros then return {} end

			local lista = {}
			for _, registro in pairs(registros) do
				if type(registro) == "table" then
					local estado = registro.State
					if estado == nil or estado == "Slot" or estado == "Dropped" then
						local categoria = registro.AssetCategory or registro.AssetId or registro.Category
						local cfg = categoria and Assets and Assets.Directory and Assets.Directory[categoria] or nil
						local nombre = (cfg and (cfg.DisplayName or cfg.Name)) or tostring(categoria or "?")
						local rareza = cfg and cfg.Rarity or nil
						local rarezaId = rareza and (rareza.DisplayName or rareza._id) or nil
						local rarezaNum = rareza and tonumber(rareza.RarityNumber or rareza.Rank) or 0
						local incomeBase = cfg and tonumber(cfg.EarningRate) or 0
						local escala = tonumber(registro.AssetScale or registro.Scale) or 1
						local mutaciones = registro.Mutations or {}
						local income = incomeBase * Crecimiento(escala)
						if #mutaciones > 0 and Mutations and type(Mutations.EarningsFor) == "function" then
							local ok, extra = pcall(Mutations.EarningsFor, registro)
							if ok and type(extra) == "number" and extra > 0 then
								income = extra
							end
						elseif #mutaciones > 0 then
							income = income * (1 + #mutaciones * 0.25)
						end

						table.insert(lista, {
							id = registro.Uid or registro.uid,
							uid = registro.Uid or registro.uid,
							nombre = nombre,
							categoria = categoria,
							icono = cfg and (cfg.Icon or cfg.Thumbnail) or nil,
							area = registro.AreaId,
							posicion = PosicionDe(registro),
							income = income,
							incomeTexto = FormatoCorto(income),
							tamanoTexto = string.format("%.2fx", escala),
							escala = escala,
							rarityTexto = rarezaId,
							rarityRank = rarezaNum,
							rarityColor = rarezaId and COLORES[rarezaId] or nil,
							mutaciones = mutaciones,
						})
					end
				end
			end
			return lista
		end

		-- ---------- acciones ----------
		local function Agarrar(datos)
			if not EggState or not datos or not datos.uid then return false end
			if type(EggState.CarryFieldEgg) == "function" then
				local ok, exito = pcall(EggState.CarryFieldEgg, datos.uid)
				return ok and exito ~= false
			end
			if type(EggState.RequestCarryAreaEgg) == "function" then
				local ok, exito = pcall(EggState.RequestCarryAreaEgg, datos.uid)
				return ok and exito ~= false
			end
			return false
		end

		local function Soltar()
			if not EggState then return false end
			if type(EggState.DropFieldEgg) == "function" then
				local ok, exito = pcall(EggState.DropFieldEgg, "PlayerRequest")
				return ok and exito ~= false
			end
			if type(EggState.RequestDropHeldAreaEgg) == "function" then
				local ok, exito = pcall(EggState.RequestDropHeldAreaEgg, "PlayerRequest")
				return ok and exito ~= false
			end
			return false
		end

		local function Cargado()
			local registros = RegistrosDelCampo()
			if not registros then return nil end
			for _, registro in pairs(registros) do
				if type(registro) == "table" and registro.State == "Carried" and registro.CarrierUserId == LocalPlayer.UserId then
					return registro
				end
			end
			return nil
		end

		-- ---------- Auto Hatch ----------
		local HatchOn = false
