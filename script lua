	-- COMBATE: Auto Hit + Hit Aura
	-- El controlador del juego (_onActivated) ya elige el objetivo más cercano,
	-- respeta su cooldown de 0.6 s y ToolGameplayGuard, así que acá solo
	-- disparamos tool:Activate() cuando hay alguien en rango.
	-- =====================================================
	do
		local Guard = nil
		pcall(function()
			Guard = require(ReplicatedStorage.Library.Client.ToolGameplayGuard)
		end)

		local AutoHitOn, HitAuraOn = false, false
		local PALABRAS = {"bat", "katana", "axe", "staff", "club", "hammer", "sword", "blade"}

		local function HRP()
			local char = LocalPlayer.Character
			return char and char:FindFirstChild("HumanoidRootPart")
		end

		local function Herramienta()
			local char = LocalPlayer.Character
			if not char then return nil end
			local tool = char:FindFirstChildOfClass("Tool")
			if not tool then return nil end
			local ok, esBat = pcall(function() return tool:GetAttribute("IsBat") end)
			if ok and esBat == true then return tool end
			local ok2, nombre = pcall(function() return tool:GetAttribute("GearName") end)
			if ok2 and type(nombre) == "string" then
				local n = string.lower(nombre)
				for _, palabra in ipairs(PALABRAS) do
					if string.find(n, palabra, 1, true) then return tool end
				end
			end
			return nil
		end

		-- No disparamos dentro de la zona segura: el juego lo rechaza igual, pero
		-- así evitamos el cartel "Cannot use items in the safe zone!".
		local function EnZonaGameplay()
			if Guard and Guard.IsLocalPlayerInGameplayArea then
				local ok, dentro = pcall(Guard.IsLocalPlayerInGameplayArea)
				return ok and dentro == true
			end
			return true
		end

		local function JugadorCerca(radio)
			local hrp = HRP()
			if not hrp then return false end
			for _, otro in ipairs(Players:GetPlayers()) do
				if otro ~= LocalPlayer and otro.Character then
					local ohrp = otro.Character:FindFirstChild("HumanoidRootPart")
					local hum = otro.Character:FindFirstChildOfClass("Humanoid")
					if ohrp and hum and hum.Health > 0 then
						if (ohrp.Position - hrp.Position).Magnitude <= radio then
							return true
						end
					end
				end
			end
			return false
		end

		task.spawn(function()
			while ScreenGui.Parent do
				task.wait(0.7)
				if AutoHitOn or HitAuraOn then
					local tool = Herramienta()
					if tool and EnZonaGameplay() then
						local radio = HitAuraOn and 40 or 22
						if JugadorCerca(radio) then
							pcall(function() tool:Activate() end)
						end
					end
				end
			end
		end)

		if AjustesRegistrar then
			AjustesRegistrar("Auto Hit", function(on)
				AutoHitOn = on and true or false
			end)
			AjustesRegistrar("Hit Aura", function(on)
				HitAuraOn = on and true or false
			end)
		end

		-- ---------- ventana propia del combate ----------
		local VentanaCombate = Instance.new("Frame")
		VentanaCombate.Size = UDim2.new(0, 224, 0, 104)
		VentanaCombate.Position = UDim2.new(0, 10, 0, 150)
		VentanaCombate.BackgroundColor3 = Color3.fromRGB(9, 11, 17)
		VentanaCombate.BackgroundTransparency = 0.06
		VentanaCombate.BorderSizePixel = 0
		VentanaCombate.Active = true
		VentanaCombate.Draggable = true
		VentanaCombate.ZIndex = 57
		VentanaCombate.Parent = ScreenGui

		local vcCorner = Instance.new("UICorner")
		vcCorner.CornerRadius = UDim.new(0, 12)
		vcCorner.Parent = VentanaCombate

		local vcStroke = Instance.new("UIStroke")
		vcStroke.Color = Color3.fromRGB(90, 140, 220)
		vcStroke.Thickness = 1.3
		vcStroke.Transparency = 0.25
		vcStroke.Parent = VentanaCombate

		local vcGrad = Instance.new("UIGradient")
		vcGrad.Color = ColorSequence.new(Color3.fromRGB(26, 30, 44), Color3.fromRGB(9, 11, 17))
		vcGrad.Rotation = 135
		vcGrad.Parent = VentanaCombate

		local vcTitulo = Instance.new("TextLabel")
		vcTitulo.Size = UDim2.new(1, -24, 0, 18)
		vcTitulo.Position = UDim2.new(0, 12, 0, 8)
		vcTitulo.BackgroundTransparency = 1
		vcTitulo.Text = "Combate"
		vcTitulo.TextColor3 = Color3.fromRGB(150, 200, 255)
		vcTitulo.Font = Enum.Font.GothamBold
		vcTitulo.TextSize = 12
		vcTitulo.TextXAlignment = Enum.TextXAlignment.Left
		vcTitulo.ZIndex = 58
		vcTitulo.Parent = VentanaCombate

		local function filaCombate(y, etiqueta)
			local nombre = Instance.new("TextLabel")
			nombre.Size = UDim2.new(0, 92, 0, 14)
			nombre.Position = UDim2.new(0, 12, 0, y)
			nombre.BackgroundTransparency = 1
			nombre.Text = etiqueta
			nombre.TextColor3 = Color3.fromRGB(130, 140, 165)
			nombre.Font = Enum.Font.GothamMedium
			nombre.TextSize = 9
			nombre.TextXAlignment = Enum.TextXAlignment.Left
			nombre.ZIndex = 58
			nombre.Parent = VentanaCombate

			local valor = Instance.new("TextLabel")
			valor.Size = UDim2.new(1, -112, 0, 14)
			valor.Position = UDim2.new(0, 100, 0, y)
			valor.BackgroundTransparency = 1
			valor.Text = "--"
			valor.TextColor3 = Color3.fromRGB(235, 240, 255)
			valor.Font = Enum.Font.GothamBold
			valor.TextSize = 10
			valor.TextXAlignment = Enum.TextXAlignment.Left
			valor.ZIndex = 58
			valor.Parent = VentanaCombate
			return valor
		end

		local vcBate = filaCombate(30, "Bate")
		local vcModo = filaCombate(46, "Modo")
		local vcCerca = filaCombate(62, "Más cercano")
		local vcZona = filaCombate(78, "Zona")

		task.spawn(function()
			while ScreenGui.Parent do
				task.wait(0.5)
				if VentanaCombate.Visible then
					local tool = Herramienta()
					vcBate.Text = tool and (tool.Name) or "sin bate"
					vcBate.TextColor3 = tool and Color3.fromRGB(120, 235, 175) or Color3.fromRGB(200, 140, 140)

					if AutoHitOn and HitAuraOn then
						vcModo.Text = "Auto Hit + Aura"
					elseif AutoHitOn then
						vcModo.Text = "Auto Hit (22)"
					elseif HitAuraOn then
						vcModo.Text = "Hit Aura (40)"
					else
						vcModo.Text = "apagado"
					end

					local hrp = HRP()
					local mejor, distancia = nil, nil
					if hrp then
						for _, otro in ipairs(Players:GetPlayers()) do
							if otro ~= LocalPlayer and otro.Character then
								local ohrp = otro.Character:FindFirstChild("HumanoidRootPart")
								local hum = otro.Character:FindFirstChildOfClass("Humanoid")
								if ohrp and hum and hum.Health > 0 then
									local d = (ohrp.Position - hrp.Position).Magnitude
									if not distancia or d < distancia then
										mejor, distancia = otro.Name, d
									end
								end
							end
						end
					end
					vcCerca.Text = mejor and (mejor .. "  " .. string.format("%.0f", distancia) .. " st") or "nadie"

					local dentro = EnZonaGameplay()
					vcZona.Text = dentro and "gameplay (puede pegar)" or "zona segura (bloqueado)"
					vcZona.TextColor3 = dentro and Color3.fromRGB(120, 235, 175) or Color3.fromRGB(255, 190, 110)
				end
			end
		end)

		if Gestor then
			Gestor.Registrar("Combate", VentanaCombate, false, function()
				return AutoHitOn or HitAuraOn
			end)
		end
		AddCleanup(function()
			AutoHitOn, HitAuraOn = false, false
		end)
	end

	-- =====================================================
	-- ESCALA DE INTERFAZ + PREDICTOR
	-- (el volcado no tiene endpoints de Rift / Boss / Mutation / Scramble:
	--  los prefijos de red son MurderMystery, ActiveAssets, Eggs, Treadmills,
	--  Trading, Plots, FuseMachine, Trails, Backpack, Guards, ... y ninguno más)
	-- =====================================================
	do
		local function Crecimiento(escala)
			if escala > 5 then
				return (escala / 5) ^ 1.2 * 19.637875755794113
			end
			return escala ^ 1.85
		end

		local function FormatoCorto(n)
			if n >= 1e12 then return string.format("%.2fT", n / 1e12) end
			if n >= 1e9 then return string.format("%.2fB", n / 1e9) end
			if n >= 1e6 then return string.format("%.2fm", n / 1e6) end
			if n >= 1e3 then return string.format("%.1fK", n / 1e3) end
			return tostring(math.floor(n + 0.5))
		end

		-- ---------- Configuración de escala ----------
		local function AplicarEscala(porcentaje)
			local factor = math.clamp((tonumber(porcentaje) or 100) / 100, 0.5, 1)
			for _, hijo in ipairs(ScreenGui:GetChildren()) do
				if hijo:IsA("GuiObject") then
					local escala = hijo:FindFirstChildOfClass("UIScale")
					if not escala then
						escala = Instance.new("UIScale")
						escala.Parent = hijo
					end
					escala.Scale = factor
				end
			end
		end

		-- ---------- Predictor ----------
		local PredictorOn = false
		task.spawn(function()
			while ScreenGui.Parent do
				task.wait(20)
				if PredictorOn and Objetivos and Objetivos.Lista and Objetivos.Notificar then
					local lista = Objetivos.Lista()
					local top = lista and lista[1]
					if top and type(top.escala) == "number" and type(top.income) == "number" then
						local base = Crecimiento(top.escala)
						if base > 0 then
							local proyectado = top.income * (Crecimiento(10) / base)
							Objetivos.Notificar(
								tostring(top.nombre) .. ": hoy " .. tostring(top.incomeTexto)
								.. " · a x10 " .. FormatoCorto(proyectado),
								true
							)
						end
					end
				end
			end
		end)

		if AjustesRegistrar then
			AjustesRegistrar("Configuración de escala", function(valor)
				AplicarEscala(valor)
				if Objetivos and Objetivos.Notificar then
					Objetivos.Notificar("Escala de interfaz: " .. tostring(math.floor(tonumber(valor) or 100)) .. "%", true)
				end
			end)
			AjustesRegistrar("Predictor", function(on)
				PredictorOn = on and true or false
				if PredictorOn and Objetivos then
					Objetivos.Notificar("Predictor: proyecta el mejor huevo cada 20 s", true)
				end
			end)
		end

		AddCleanup(function()
			PredictorOn = false
			pcall(AplicarEscala, 100)
		end)
	end

