	-- =====================================================
	-- PRIORIDAD DE RIFT + HUEVOS ESPECÍFICOS
	-- Rift: pregunta la receta al juego (RF/Rift/AskState), ve qué te falta y
	-- pone esos huevos primeros en la lista, como el "Steal Missing Rift Eggs".
	-- =====================================================
	do
		local faltantes = {}
		local RiftOn = false
		local UltimaConsulta = 0

		local function Remoto(nombre)
			local networking = Juego and Juego.Networking
			if not networking then return nil end
			local r = networking:FindFirstChild(nombre)
			if r and (r:IsA("RemoteFunction") or r:IsA("RemoteEvent")) then return r end
			return nil
		end

		local function Llamar(nombre, ...)
			local r = Remoto(nombre)
			if not r then return nil end
			if r:IsA("RemoteFunction") then
				local ok, a = pcall(r.InvokeServer, r, ...)
				return ok and a or nil
			end
			local ok = pcall(r.FireServer, r, ...)
			return ok or nil
		end

		-- Lo que ya tenés (inventario, huevos y el índice)
		local function Poseidos()
			local set = {}
			local save = Juego and Juego.Save
			if not save or type(save.Get) ~= "function" then return set end
			local ok, datos = pcall(save.Get)
			if not ok or type(datos) ~= "table" then return set end
			for _, mapa in ipairs({datos.Inventory or {}, datos.EggInventory or {}, datos.Index or {}}) do
				for clave, valor in pairs(mapa) do
					if type(clave) == "string" then
						set[clave] = true
					elseif type(valor) == "table" then
						local categoria = valor.Category or valor.AssetCategory
						if categoria then set[tostring(categoria)] = true end
					end
				end
			end
			return set
		end

		local function ConsultarRift()
			local estado = Llamar("RF/Rift/AskState")
			if type(estado) ~= "table" then return false end
			local requisitos = estado.Requirements or estado.requirements
			if type(requisitos) ~= "table" then return false end
			local poseidos = Poseidos()
			faltantes = {}
			local cuantos = 0
			for _, requisito in pairs(requisitos) do
				local categoria = type(requisito) == "table" and (requisito.Category or requisito.AssetCategory) or requisito
				if type(categoria) == "string" and not poseidos[categoria] then
					faltantes[categoria] = true
					cuantos = cuantos + 1
				end
			end
			if Objetivos and Objetivos.Lista then
				for _, item in ipairs(Objetivos.Lista()) do
					item.rift = faltantes[item.categoria] == true
				end
			end
			if Objetivos and Objetivos.SetPreferidos then
				if next(faltantes) == nil then
					Objetivos.SetPreferidos(nil)
				else
					Objetivos.SetPreferidos(function(item)
						return faltantes[item.categoria] == true
					end)
				end
			end
			return true, cuantos
		end

