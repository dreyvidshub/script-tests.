					local pb = Preferidos(b) and 1 or 0
					if pa ~= pb then
						return pa > pb
					end
				end
				if Prioridad == 1 then
					return (a.rarityRank or 0) > (b.rarityRank or 0)
				end
				if Prioridad == 2 then
					return (a.escala or 0) > (b.escala or 0)
				end
				if Prioridad == 3 then
					return #(a.mutaciones or {}) > #(b.mutaciones or {})
				end
				if Prioridad == 5 then
					return (a.income or 0) < (b.income or 0)
				end
				return (a.income or 0) > (b.income or 0)
