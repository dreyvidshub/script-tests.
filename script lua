	-- =====================================================
	-- MOTOR DE ROBO (Instant Steal): guiar -> agarrar -> soltar/recoger -> volver
	-- =====================================================
	do
		local Activo = false
		local Cancelado = false
		local Hooks = {leerHuevos = nil, agarrar = nil, soltar = nil}
		local UltimoRefresco = 0

		-- Zonas y tiempos calibrados del juego
		local SAFE = {minX = 365.3, maxX = 551.4, minZ = -581.4, maxZ = -146.9, y = 70.8, cx = 458.3, cz = -364.2}
		local CAMPO = {minX = 555.4, maxX = 6015.0, minZ = -433.3, maxZ = -295.1}
		local ZONA_ATERRIZAJE = {minX = 655, maxX = 1120, minZ = -430, maxZ = -298}
		local VEL_IDA = 300
		local VEL_VUELTA = 2000
		local TIMEOUT_IDA = 12
		local TIMEOUT_VUELTA = 6
		local TIMEOUT_AGARRE = 2
		local REFRESCO = 2

		local function EsperarHRP()
			local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if not hrp then
				local t0 = os.clock()
				while not hrp and os.clock() - t0 < 3 do
					task.wait(0.1)
					hrp = char:FindFirstChild("HumanoidRootPart")
				end
			end
			return hrp
		end

		local function EnZonaSegura(pos)
			return pos.X >= SAFE.minX and pos.X <= SAFE.maxX and pos.Z >= SAFE.minZ and pos.Z <= SAFE.maxZ
		end

		local function EnCampo(pos)
			return pos.X >= CAMPO.minX and pos.X <= CAMPO.maxX and pos.Z >= CAMPO.minZ and pos.Z <= CAMPO.maxZ
		end

		local function HumanoDe(hrp)
			local char = hrp and hrp.Parent
			return char and char:FindFirstChildOfClass("Humanoid")
		end

		-- Camina hacia un punto (sin teletransporte): así lo hace el hub original en la ida.
		local function MoverA(destino, velocidad, timeout)
			local hrp = EsperarHRP()
			if not hrp then return false end
			local hum = HumanoDe(hrp)
			if not hum then return false end
			local original = hum.WalkSpeed
			pcall(function() hum.WalkSpeed = math.clamp(velocidad, 16, 1000) end)

			local t0 = os.clock()
			local quieto = 0
			local llego = false
			while not Cancelado and os.clock() - t0 < timeout do
				local actual = hrp.Position
				local plano = Vector3.new(actual.X, 0, actual.Z)
				local meta = Vector3.new(destino.X, 0, destino.Z)
				if (plano - meta).Magnitude <= 6 then
					llego = true
					break
				end
				pcall(function() hum:MoveTo(destino) end)
				task.wait(0.15)
				if (hrp.Position - actual).Magnitude < 0.6 then
					quieto = quieto + 1
					if quieto >= 6 then
						pcall(function() hum.Jump = true end)
						quieto = 0
					end
				else
					quieto = 0
				end
			end

			pcall(function() hum:MoveTo(hrp.Position) end)
			pcall(function() hum.WalkSpeed = original end)
			return llego
		end

		-- Vuelta: teletransporte por saltos (modo teleport-lerp) hasta la zona segura.
		local function VolverRapido()
			local hrp = EsperarHRP()
			if not hrp then return false end
			if EnZonaSegura(hrp.Position) then return true end
			local t0 = os.clock()
			while not Cancelado and os.clock() - t0 < TIMEOUT_VUELTA do
				local pos = hrp.Position
				if EnZonaSegura(pos) then return true end
				local destino = Vector3.new(SAFE.cx, SAFE.y + 3, SAFE.cz)
				local salto = pos:Lerp(destino, 0.45)
				pcall(function()
					hrp.CFrame = CFrame.new(salto) * hrp.CFrame.Rotation
					hrp.AssemblyLinearVelocity = Vector3.zero
					hrp.AssemblyAngularVelocity = Vector3.zero
				end)
				task.wait(0.05)
			end
			return EnZonaSegura(hrp.Position)
		end

		local function Terminar(mensaje, exito)
			Activo = false
			if Objetivos then
				Objetivos.Estado("INSTANT STEAL", Color3.fromRGB(225, 232, 245))
				if mensaje then Objetivos.Notificar(mensaje, exito) end
			end
		end

		local function Robar(datos)
			if Objetivos then Objetivos.Estado("EN CAMINANDO", Color3.fromRGB(255, 210, 120)) end

			local hrp = EsperarHRP()
			if not hrp then
				return Terminar("No encontré tu personaje", false)
			end

			-- Si estamos en el campo, primero volvemos a la zona segura.
			if not EnZonaSegura(hrp.Position) then
				if Objetivos then Objetivos.Notificar("Volviendo a la zona segura primero", true) end
				VolverRapido()
				if not Activo then return end
			end

			local objetivo = datos.posicion
			if not objetivo then
				return Terminar("Ese objetivo no tiene posición en el campo", false)
			end

			if Objetivos then Objetivos.Notificar("Guiando hasta " .. tostring(datos.nombre) .. "…", true) end
			local llego = MoverA(objetivo, VEL_IDA, TIMEOUT_IDA)
			if not Activo then return end
			if not llego then
				return Terminar("No llegué a " .. tostring(datos.nombre), false)
			end

			-- Agarre (con reintento corto)
			if not Hooks.agarrar then
				return Terminar("Falta la capa del juego para agarrar", false)
			end

			if Objetivos then Objetivos.Estado("AGARRANDO", Color3.fromRGB(255, 210, 120)) end
			local t0 = os.clock()
			local agarro = false
			while Activo and not agarro and os.clock() - t0 < TIMEOUT_AGARRE do
				local ok, resultado = pcall(Hooks.agarrar, datos)
				agarro = ok and (resultado ~= false)
				if not agarro then task.wait(0.1) end
			end
			if not Activo then return end
			if not agarro then
				return Terminar("No pude agarrar " .. tostring(datos.nombre), false)
			end

			if Objetivos then
				Objetivos.Notificar("Huevo agarrado: " .. tostring(datos.nombre), true)
				Objetivos.Estado("VOLVIENDO", Color3.fromRGB(150, 220, 255))
			end

			-- Caminamos hasta el borde de la zona segura cargando el huevo.
			local borde = Vector3.new(SAFE.maxX + 12, SAFE.y + 3, SAFE.cz)
			MoverA(borde, VEL_IDA, TIMEOUT_IDA)
			if not Activo then return end

			-- Drop & regrab: soltamos un instante para que guardias y trampas pierdan el rastro.
			if Hooks.soltar then
				pcall(Hooks.soltar)
				task.wait(0.15)
				pcall(Hooks.agarrar, datos)
			end
			if not Activo then return end

			-- Y recién ahí, el teletransporte de vuelta a la zona segura.
			VolverRapido()
			if not Activo then return end

			Terminar("Entregado: " .. tostring(datos.nombre), true)
		end

		local function Refrescar()
			if not Hooks.leerHuevos or not Objetivos then return end
			if os.clock() - UltimoRefresco < REFRESCO then return end
			UltimoRefresco = os.clock()
			local ok, lista = pcall(Hooks.leerHuevos)
			if not ok or type(lista) ~= "table" then return end
			Objetivos.Limpiar()
			for _, item in ipairs(lista) do
				if type(item) == "table" then
					Objetivos.Agregar(item)
				end
			end
		end

		local Robo = {
			Iniciar = function(datos)
				if Activo then
					if Objetivos then Objetivos.Notificar("Ya hay un robo en curso", false) end
					return
				end
				Activo = true
				Cancelado = false
				task.spawn(function()
					local ok, err = pcall(Robar, datos)
					if not ok then
						Terminar("Error en el robo: " .. tostring(err), false)
					end
					Activo = false
				end)
			end,
			Detener = function()
			Cancelado = true
				Activo = false
				if Objetivos then Objetivos.Notificar("Robo detenido", false) end
			end,
			Activo = function()
				return Activo
			end,
			Configurar = function(hooks)
				for _, clave in ipairs({"leerHuevos", "agarrar", "soltar"}) do
					if hooks and hooks[clave] ~= nil then
						Hooks[clave] = hooks[clave]
					end
				end
			end,
			Refrescar = Refrescar,
			Volver = VolverRapido,
			SetVelocidades = function(ida, vuelta)
				VEL_IDA = math.clamp(tonumber(ida) or VEL_IDA, 50, 1000)
				VEL_VUELTA = math.clamp(tonumber(vuelta) or VEL_VUELTA, 100, 2000)
			end,
			Zonas = {segura = SAFE, campo = CAMPO, aterrizaje = ZONA_ATERRIZAJE},
			Velocidades = {ida = VEL_IDA, vuelta = VEL_VUELTA},
		}

		if Objetivos then
			Objetivos.RegistrarRobo(Robo)
		end

		-- Refresco periódico de la lista de objetivos (cada 2 s), sin molestar al robo.
		task.spawn(function()
			while ScreenGui.Parent do
				task.wait(REFRESCO)
				if not Activo then
					pcall(Refrescar)
				end
			end
		end)

		AddCleanup(function()
			Activo = false
			if Objetivos then Objetivos.RegistrarRobo(nil) end
		end)
	end

	-- =====================================================
	-- GUARDIAS: Chasing (aviso) + Anti Guard (escape)
	-- =====================================================
	do
		local Guardias = {}
		local UltimoEscaneo = 0
		local UltimoAviso = {}
		local ChasingOn = false
		local AntiGuardOn = false
		local Escapando = false

		-- Los guardias del juego traen los atributos GuardState / TargetPlayer /
		-- WakeTargetPlayer (confirmado en el volcado del .rbxl).
		local function EsMio(valor)
			if valor == nil then return false end
			if type(valor) == "number" then return valor == LocalPlayer.UserId end
			if type(valor) == "string" then
				if valor == "" then return false end
				return valor == LocalPlayer.Name or valor == tostring(LocalPlayer.UserId)
			end
			return false
		end

		local function BuscarGuardias()
			Guardias = {}
			local pila = {Workspace}
			local vistos = 0
			while #pila > 0 and vistos < 5000 do
				local actual = table.remove(pila)
				for _, hijo in ipairs(actual:GetChildren()) do
					vistos = vistos + 1
					pila[#pila + 1] = hijo
					local ok, estado = pcall(function() return hijo:GetAttribute("GuardState") end)
					if ok and estado ~= nil then
						table.insert(Guardias, hijo)
					end
				end
			end
			return #Guardias
		end

		local function EnZonaSegura(pos)
			return pos.X >= 365.3 and pos.X <= 551.4 and pos.Z >= -581.4 and pos.Z <= -146.9
		end

		-- ---------- ventana propia del Anti Guard ----------
		local RadioAntiGuard = 40
		local ContadorAntiGuard = 0
		local EstadoAntiGuard = "libre"
		local CercaAntiGuard = nil

		-- posición de un guardia
		local function PosicionDe(inst)
			if not inst or not inst.Parent then return nil end
			if inst:IsA("BasePart") then return inst.Position end
			local principal = nil
			if inst:IsA("Model") then
				principal = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart")
			else
				principal = inst:FindFirstChildWhichIsA("BasePart", true)
			end
			return principal and principal.Position or nil
		end

		local function Escapar()
			if Escapando then return end
			local motor = Objetivos and Objetivos.Robo and Objetivos.Robo()
			if not motor or not motor.Volver then return end
			local char = LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not hrp or EnZonaSegura(hrp.Position) then return end
			Escapando = true
			ContadorAntiGuard = ContadorAntiGuard + 1
			EstadoAntiGuard = "escapando a la zona segura"
			task.spawn(function()
				if Objetivos then Objetivos.Notificar("Guardia encima: escapando a la zona segura", false) end
				pcall(motor.Volver)
				Escapando = false
			end)
		end

		local function Revisar()
			if os.clock() - UltimoEscaneo > 5 then
				UltimoEscaneo = os.clock()
				pcall(BuscarGuardias)
			end
			if #Guardias == 0 then
				EstadoAntiGuard = "sin guardias cerca"
				return
			end
			EstadoAntiGuard = "vigilando"
			CercaAntiGuard = nil

