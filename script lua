		Alternar = function(id, valor)
			Est[id] = valor
			local fn = Aplicar[id]
			if fn then
				local ok = pcall(fn, valor)
				if not ok then Aviso("No se pudo aplicar " .. id, false) end
			end
			local sw = Switches[id]
			if sw then sw.Set(valor) end
			-- Solo las funciones con ventana propia (o las que importan a la vista)
			-- muestran pastilla abajo; el resto no ensucia la pantalla.
			if valor and CON_PASTILLA[id] then
				PonerPill(id)
			else
				QuitarPill(id)
			end
		end

		-- ---------- stepper en pastilla ----------
		local function Stepper(parent, cfg, alCambiar)
			local caja = Instance.new("Frame")
			caja.Size = UDim2.new(0, 116, 0, 24)
			caja.BackgroundTransparency = 1
			caja.ZIndex = 65
			caja.Parent = parent

			local valor = cfg.valor or cfg.min

			local etiqueta = Instance.new("TextLabel")
			etiqueta.Size = UDim2.new(0, 68, 1, 0)
			etiqueta.Position = UDim2.new(0, 24, 0, 0)
			etiqueta.BackgroundColor3 = Color3.fromRGB(20, 26, 40)
			etiqueta.TextColor3 = Color3.fromRGB(150, 205, 255)
			etiqueta.Font = Enum.Font.GothamBold
			etiqueta.TextSize = 10
			etiqueta.ZIndex = 65
			etiqueta.Parent = caja

			local ec = Instance.new("UICorner")
			ec.CornerRadius = UDim.new(1, 0)
			ec.Parent = etiqueta

			local es = Instance.new("UIStroke")
			es.Color = Color3.fromRGB(70, 110, 170)
			es.Transparency = 0.4
			es.Parent = etiqueta

			local function formatear(v)
				if cfg.decimales then
					return string.format("%." .. tostring(cfg.decimales) .. "f", v)
				end
				return tostring(math.floor(v + 0.5))
			end

			local function pintar()
				etiqueta.Text = formatear(valor) .. (cfg.sufijo or "")
			end

			local function boton(texto, x, signo)
				local b = Instance.new("TextButton")
				b.Size = UDim2.new(0, 22, 1, 0)
				b.Position = UDim2.new(0, x, 0, 0)
				b.BackgroundColor3 = Color3.fromRGB(28, 34, 48)
				b.Text = texto
				b.TextColor3 = Color3.fromRGB(150, 200, 255)
				b.Font = Enum.Font.GothamBold
				b.TextSize = 13
				b.AutoButtonColor = false
				b.ZIndex = 65
				b.Parent = caja

				local bc = Instance.new("UICorner")
				bc.CornerRadius = UDim.new(1, 0)
				bc.Parent = b

				local bs = Instance.new("UIStroke")
				bs.Color = Color3.fromRGB(70, 100, 150)
				bs.Transparency = 0.5
				bs.Parent = b

				b.MouseButton1Click:Connect(function()
					valor = math.clamp(valor + signo * (cfg.paso or 1), cfg.min, cfg.max)
					pintar()
					if alCambiar then alCambiar(valor) end
				end)
			end

			boton("-", 0, -1)
			boton("+", 94, 1)
			pintar()

			return {
				instancia = caja,
				Get = function()
					return valor
				end,
				Set = function(v)
					valor = math.clamp(v, cfg.min, cfg.max)
					pintar()
				end,
			}
		end

