-- ===== LIMPIEZA ENTRE EJECUCIONES / RECONSTRUCCIONES =====
-- Todo lo que se conecta o se crea dentro de BuildHub se registra acá, para que
-- reconstruir el hub no deje loops vivos ni plataformas huérfanas.
local BuildCleanup = {}

local function RunBuildCleanup()
	for _, fn in ipairs(BuildCleanup) do pcall(fn) end
	BuildCleanup = {}
end

local function AddCleanup(fn)
	table.insert(BuildCleanup, fn)
end

local function TrackConnection(conn)
	if conn then
		AddCleanup(function() pcall(function() conn:Disconnect() end) end)
	end
	return conn
end

-- La Subida se registra acá para que el Anti-Hit pueda suspenderla mientras
-- teleporta: si no, el clamp de "no bajas" cancela el anti-hit al instante.
local SubidaRuntime = nil

-- ===== AGARRE INSTANTÁNEO (dueño único de los ProximityPrompt) =====
-- Antes esto vivía dentro del Anti-Hit y solo se activaba con él. Ahora es
-- permanente porque la Subida también lo necesita, y así los dos módulos no se
-- pelean por el HoldDuration.
local HOLD_ATTR = "_DreyvidHold"
local LOS_ATTR = "_DreyvidLos"
local SavedPrompts = setmetatable({}, { __mode = "k" })
local PromptConnections = {}
local PromptPatchActive = false

local function TriggerAntiHit()
	local Character = LocalPlayer.Character
	if not Character then return end
	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	local RootPart = Character:FindFirstChild("HumanoidRootPart")
	if not Humanoid or not RootPart then return end
	local OriginalCameraCFrame = Camera.CFrame
	local OriginalCameraType = Camera.CameraType
	local hb
	-- Todo va en pcall para que la cámara y la Subida SIEMPRE se restauren,
	-- aunque el personaje muera a mitad del teleport.
	pcall(function()
		if SubidaRuntime and SubidaRuntime.Suspend then SubidaRuntime.Suspend() end
		Camera.CameraType = Enum.CameraType.Scriptable
		Camera.CFrame = OriginalCameraCFrame
		Humanoid.BreakJointsOnDeath = false
		for _, Descendant in ipairs(Character:GetDescendants()) do
			if Descendant:IsA("Motor6D") then Descendant.Enabled = true end
		end
		RootPart.AssemblyLinearVelocity = Vector3.zero
		RootPart.AssemblyAngularVelocity = Vector3.zero
		for _, TargetCFrame in ipairs(TeleportPositions) do
			Humanoid.PlatformStand = true
			Humanoid.Health = 100
			RootPart.CFrame = TargetCFrame
			RootPart.AssemblyLinearVelocity = Vector3.zero
			Camera.CFrame = OriginalCameraCFrame
			task.wait(0.02)
		end
		local t0 = os.clock()
		hb = RunService.Heartbeat:Connect(function()
			if os.clock() - t0 > 0.35 then hb:Disconnect() return end
			Humanoid.Health = 100
			Humanoid.PlatformStand = true
			RootPart.CFrame = TeleportPositions[#TeleportPositions]
			RootPart.AssemblyLinearVelocity = Vector3.zero
			RootPart.AssemblyAngularVelocity = Vector3.zero
			Camera.CFrame = OriginalCameraCFrame
		end)
		task.wait(0.35)
	end)
	if hb then pcall(function() hb:Disconnect() end) end
	pcall(function()
		Humanoid.PlatformStand = false
		Camera.CameraType = OriginalCameraType
		Camera.CFrame = OriginalCameraCFrame
		if SubidaRuntime and SubidaRuntime.Resume then SubidaRuntime.Resume() end
	end)
end

local function PatchPrompt(Prompt)
	if not (Prompt and typeof(Prompt) == "Instance" and Prompt:IsA("ProximityPrompt")) then return end
	if SavedPrompts[Prompt] == nil then
		local hold = Prompt.HoldDuration
		local los = Prompt.RequiresLineOfSight
		-- El original se guarda también como atributo del prompt: así sobrevive
		-- a re-ejecutar el script (la tabla Lua se pierde, el atributo no).
		local okHold, attrHold = pcall(function() return Prompt:GetAttribute(HOLD_ATTR) end)
		if okHold and type(attrHold) == "number" then hold = attrHold end
		local okLos, attrLos = pcall(function() return Prompt:GetAttribute(LOS_ATTR) end)
		if okLos and type(attrLos) == "boolean" then los = attrLos end
		SavedPrompts[Prompt] = { hold = hold, los = los }
		pcall(function()
			Prompt:SetAttribute(HOLD_ATTR, hold)
			Prompt:SetAttribute(LOS_ATTR, los)
		end)
	end
	if Prompt.HoldDuration ~= 0 then pcall(function() Prompt.HoldDuration = 0 end) end
	if Prompt.RequiresLineOfSight then pcall(function() Prompt.RequiresLineOfSight = false end) end
end

local function StartPromptPatch()
	if PromptPatchActive then return end
	PromptPatchActive = true
	for _, item in ipairs(Workspace:GetDescendants()) do PatchPrompt(item) end
	table.insert(PromptConnections, Workspace.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("ProximityPrompt") then PatchPrompt(descendant) end
	end))
	table.insert(PromptConnections, PromptService.PromptShown:Connect(PatchPrompt))
end

local function StopPromptPatch(restore)
	PromptPatchActive = false
	for _, Connection in ipairs(PromptConnections) do
		pcall(function() Connection:Disconnect() end)
	end
	PromptConnections = {}
	if restore then
		for Prompt, saved in pairs(SavedPrompts) do
			if Prompt and Prompt.Parent then
				pcall(function()
					Prompt.HoldDuration = saved.hold
					Prompt.RequiresLineOfSight = saved.los
				end)
			end
		end
		SavedPrompts = setmetatable({}, { __mode = "k" })
	end
end

