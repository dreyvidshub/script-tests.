			nota.ZIndex = 63
			nota.Parent = fila

			if item.tipo == "no" then
				local pill = Pastilla(fila, {si = "NO DISP.", ancho = 76, bloqueada = true, texto = 9}, false, nil)
				pill.instancia.Position = UDim2.new(1, -90, 0.5, -12)
				pill.instancia.TextColor3 = Color3.fromRGB(160, 160, 170)
				return fila
			end

			if item.tipo == "pronto" then
				local pill = Pastilla(fila, {si = "PRONTO", ancho = 76, bloqueada = true}, false, nil)
				pill.instancia.Position = UDim2.new(1, -90, 0.5, -12)
				return fila
			end

			if item.tipo == "info" then
				local etiqueta = Instance.new("TextLabel")
				etiqueta.Size = UDim2.new(0, 86, 0, 24)
				etiqueta.Position = UDim2.new(1, -100, 0.5, -12)
				etiqueta.BackgroundColor3 = Color3.fromRGB(22, 30, 46)
				etiqueta.Text = item.valorTexto or ""
				etiqueta.TextColor3 = Color3.fromRGB(140, 200, 255)
				etiqueta.Font = Enum.Font.GothamBold
				etiqueta.TextSize = 10
				etiqueta.ZIndex = 63
				etiqueta.Parent = fila
				local ec = Instance.new("UICorner")
				ec.CornerRadius = UDim.new(1, 0)
				ec.Parent = etiqueta
				return fila
			end

			if item.tipo == "accion" then
				local pill = Pastilla(fila, {si = item.boton or "Copiar", ancho = 76}, false, nil)
				pill.instancia.Text = item.boton or "Copiar"
				pill.instancia.BackgroundColor3 = Color3.fromRGB(24, 44, 72)
				pill.instancia.TextColor3 = Color3.fromRGB(140, 205, 255)
				pill.instancia.Position = UDim2.new(1, -90, 0.5, -12)
				pill.instancia.MouseButton1Click:Connect(function()
					if item.alPulsar then
						local ok, mensaje = pcall(item.alPulsar)
						Aviso(ok and (mensaje or "Listo") or "Error al ejecutar", ok)
					end
				end)
				return fila
			end

			if item.tipo == "stepper" then
				if type(Est[item.id]) == "number" then item.cfg.valor = Est[item.id] end
				local stepper = Stepper(fila, item.cfg, function(v)
					Est[item.id] = v
					local fn = Aplicar[item.id]
					if fn then
						local ok = pcall(fn, v)
						if not ok then Aviso("No se pudo aplicar " .. item.id, false) end
					end
				end)
				stepper.instancia.Position = UDim2.new(1, -132, 0.5, -12)
				Est[item.id] = stepper.Get()
				return fila
			end

			-- toggle con pastilla
			if type(Est[item.id]) ~= "boolean" then Est[item.id] = item.valor and true or false end
			local pill = Pastilla(fila, {si = "ON", no = "OFF", ancho = 76}, Est[item.id], function(v)
				Alternar(item.id, v)
				Aviso(item.id .. (v and " activado" or " apagado"), v)
			end)
			pill.instancia.Position = UDim2.new(1, -90, 0.5, -12)
			Switches[item.id] = { Set = function(v) pill.Set(v) end }
			if Est[item.id] and CON_PASTILLA[item.id] then PonerPill(item.id) end

			return fila
		end

