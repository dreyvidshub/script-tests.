							datos = EggState.ReadOwnerEggs(LocalPlayer.UserId)
						end
					end)
					if type(datos) == "table" then
						local registros = datos.Records or datos
						for uid in pairs(registros) do
							local listo = false
							pcall(function()
								listo = EggState.IsReadyToHatch(uid) == true
							end)
							if listo and (HatchCooldown[uid] or 0) < os.clock() then
								HatchCooldown[uid] = os.clock() + 8
								local hecho = false
								for _, nombre in ipairs({ "HatchEgg", "RequestHatchEgg", "CompleteHatchEgg" }) do
									if type(EggState[nombre]) == "function" then
										local ok = pcall(EggState[nombre], uid)
										hecho = hecho or ok
