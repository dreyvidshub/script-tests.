		-- ---------- pastilla (botón redondeado) ----------
		local function Pastilla(parent, cfg, estadoInicial, alPulsar)
			local b = Instance.new("TextButton")
			b.Size = UDim2.new(0, cfg.ancho or 76, 0, cfg.alto or 24)
			b.BackgroundColor3 = Color3.fromRGB(40, 30, 36)
			b.Text = ""
			b.Font = Enum.Font.GothamBold
			b.TextSize = cfg.texto or 10
			b.AutoButtonColor = false
			b.ZIndex = 65
			b.Parent = parent

			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(1, 0)
			c.Parent = b

			local s = Instance.new("UIStroke")
			s.Transparency = 0.3
			s.Parent = b

			local estado = estadoInicial and true or false

			local function pintar()
				if cfg.bloqueada then
					b.BackgroundColor3 = Color3.fromRGB(32, 29, 44)
					b.TextColor3 = Color3.fromRGB(148, 132, 190)
					b.Text = cfg.si or "PRONTO"
					s.Color = Color3.fromRGB(88, 74, 128)
					s.Transparency = 0.5
					return
				end
				TweenService:Create(b, TweenInfo.new(0.18), {
					BackgroundColor3 = estado and Color3.fromRGB(24, 62, 46) or Color3.fromRGB(44, 30, 38),
					TextColor3 = estado and Color3.fromRGB(112, 235, 170) or Color3.fromRGB(228, 132, 132),
				}):Play()
				TweenService:Create(s, TweenInfo.new(0.18), {
					Color = estado and Color3.fromRGB(60, 200, 130) or Color3.fromRGB(132, 60, 76),
				}):Play()
				b.Text = estado and (cfg.si or "ON") or (cfg.no or "OFF")
			end

			pintar()

			if not cfg.bloqueada then
				b.MouseButton1Click:Connect(function()
					estado = not estado
					pintar()
					if alPulsar then alPulsar(estado) end
				end)
			end

			return {
				instancia = b,
				Set = function(v)
					estado = v and true or false
					pintar()
				end,
				Get = function()
					return estado
				end,
			}
		end

