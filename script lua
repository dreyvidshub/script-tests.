	do
		local Networking = Juego and Juego.Networking or nil
		local RedRip = nil
		pcall(function()
			RedRip = require(ReplicatedStorage.Library.Client.Network)
		end)

		local function remoto(nombre)
			if not Networking then return nil end
			local r = Networking:FindFirstChild(nombre)
			if r and (r:IsA("RemoteFunction") or r:IsA("RemoteEvent")) then
				return r
			end
			return nil
		end

		-- Llama al remote real (funcione como RemoteFunction o RemoteEvent).
		local function Llamar(nombre, ...)
			local r = remoto(nombre)
			if r then
				if r:IsA("RemoteFunction") then
					local ok, a = pcall(r.InvokeServer, r, ...)
					return ok and a or nil
				end
				local ok = pcall(r.FireServer, r, ...)
				return ok or nil
			end
			-- Respaldo: la red del rip moddeado
			if RedRip then
				local ok, a = pcall(RedRip.Invoke, nombre, ...)
				if ok then return a end
			end
			return nil
		end

		-- Prueba varios nombres y devuelve el primero que responda.
		local function LlamarAlguno(nombres, ...)
			for _, nombre in ipairs(nombres) do
				if remoto(nombre) then
					local resultado = Llamar(nombre, ...)
					if resultado ~= nil then return resultado, nombre end
				end
			end
			return nil, nil
		end

