	-- =====================================================
	-- GESTOR DE VENTANAS (menú principal + paneles que aparecen solos)
	-- Reglas:
	--   · Minimizar (logo)  -> se oculta TODO menos el logo y los avisos.
	--   · Ampliar           -> vuelve el menú principal y solo los paneles
	--                          de las funciones que están activas.
	--   · Cada función activa registra su panel: aparece y desaparece solo.
	-- =====================================================
	local Gestor = nil
	do
		local Registro = {}
		local Orden = {}
		local Expandido = true

		local function visibleDe(datos)
			if datos.fijo then return true end
			if not Expandido then return false end
			if datos.control then
				return datos.control() == true
			end
			return datos.activa == true
		end

		local function fijar(datos, visible)
			if type(datos.marcos) == "table" then
				for _, marco in ipairs(datos.marcos) do
					pcall(function() marco.Visible = visible end)
				end
			else
				pcall(function() datos.marcos.Visible = visible end)
			end
		end

		local function Aplicar()
			for _, id in ipairs(Orden) do
				local datos = Registro[id]
				if datos then
					fijar(datos, visibleDe(datos))
				end
			end
		end

		Gestor = {
			-- marcos: instancia o tabla de instancias
			-- control: función opcional que decide la visibilidad (para ventanas
			--          que además tienen su propio abrir/cerrar, como la tarjeta)
			-- fijo: nunca se oculta (logo, avisos, título)
			Registrar = function(id, marcos, activa, control, fijo)
				if not Registro[id] then
					table.insert(Orden, id)
				end
				Registro[id] = {
					marcos = marcos,
					activa = activa == true,
					control = control,
					fijo = fijo == true,
				}
				Aplicar()
			end,
			Panel = function(id, activo)
				local datos = Registro[id]
				if not datos then return end
				datos.activa = activo == true
				Aplicar()
			end,
			Activo = function(id)
				local datos = Registro[id]
				return (datos and datos.activa) == true
			end,
			Expandido = function()
				return Expandido
			end,
			-- Un solo interruptor: si hay algo abierto, minimiza todo; si no,
			-- vuelve a abrir el menú principal con sus paneles activos.
			AlternarGlobal = function()
				local menu = Registro["__menu"]
				local abierto = Expandido and (menu == nil or menu.activa == true)
				Expandido = not abierto
				if menu then menu.activa = Expandido end
				Aplicar()
			end,
			OcultarTodo = function()
				Expandido = false
				Aplicar()
			end,
			MostrarTodo = function()
				Expandido = true
				local datos = Registro["__menu"]
				if datos then datos.activa = true end
				Aplicar()
			end,
			Refrescar = Aplicar,
			Registrados = function()
				return Registro
			end,
		}

		AddCleanup(function()
			Gestor = nil
			Registro = {}
			Orden = {}
		end)
	end

