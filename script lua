		local GuardiasEsp = {}
		local UltimoEscaneoEsp = 0
		local function EscanearGuardias()
			GuardiasEsp = {}
			local pila = {Workspace}
			local vistos = 0
			while #pila > 0 and vistos < 5000 do
				local actual = table.remove(pila)
				for _, hijo in ipairs(actual:GetChildren()) do
					vistos = vistos + 1
					pila[#pila + 1] = hijo
					local ok, estado = pcall(function() return hijo:GetAttribute("GuardState") end)
					if ok and estado ~= nil then
						table.insert(GuardiasEsp, hijo)
					end
				end
			end
		end

		local function PosicionDe(instancia)
			if not instancia or not instancia.Parent then return nil end
			if instancia:IsA("BasePart") then return instancia.Position end
			if instancia:IsA("Model") then
				local principal = instancia.PrimaryPart or instancia:FindFirstChildWhichIsA("BasePart")
				return principal and principal.Position or nil
			end
			local parte = instancia:FindFirstChildWhichIsA("BasePart", true)
			return parte and parte.Position or nil
		end

		local Acumulado = 0
		RunService.RenderStepped:Connect(function(dt)
			if not EspOn then return end
			Acumulado = Acumulado + dt
			if Acumulado < 0.08 then return end
			Acumulado = 0
			if os.clock() - UltimoEscaneoEsp > 5 then
				UltimoEscaneoEsp = os.clock()
				pcall(EscanearGuardias)
			end

			local cam = Workspace.CurrentCamera
			if not cam then return end

			local lista = {}
			local miHRP = HRP()
			local posicion = miHRP and miHRP.Position

			for _, objetivo in ipairs((Objetivos and Objetivos.Lista and Objetivos.Lista()) or {}) do
				if EspHuevos and objetivo.posicion then
					table.insert(lista, {
						pos = objetivo.posicion,
						texto = tostring(objetivo.nombre) .. "  " .. tostring(objetivo.incomeTexto or ""),
						distancia = posicion and (objetivo.posicion - posicion).Magnitude or nil,
						color = Color3.fromRGB(90, 230, 140),
					})
				end
			end

			for _, guardia in ipairs(GuardiasEsp) do
				local pos = PosicionDe(guardia)
				if EspGuardias and pos then
					local estadoGuardia = tostring(guardia:GetAttribute("GuardState") or "")
					local colorGuardia = Color3.fromRGB(255, 90, 90)
					if estadoGuardia == "Sleeping" then
						colorGuardia = Color3.fromRGB(255, 180, 90)
					elseif estadoGuardia == "Chasing" then
						colorGuardia = Color3.fromRGB(255, 60, 60)
					end
					table.insert(lista, {
						pos = pos,
						texto = "GUARDIA " .. estadoGuardia,
						distancia = posicion and (pos - posicion).Magnitude or nil,
						color = colorGuardia,
					})
				end
			end

			for _, jugador in ipairs(Players:GetPlayers()) do
				if jugador ~= LocalPlayer and jugador.Character then
					local hrp = jugador.Character:FindFirstChild("HumanoidRootPart")
					local hum = jugador.Character:FindFirstChildOfClass("Humanoid")
					if EspJugadores and hrp and hum and hum.Health > 0 then
						local posicionJugador = hrp.Position
						local distancia = posicion and (posicionJugador - posicion).Magnitude or nil
						local dentroX = posicionJugador.X > 365.3 and posicionJugador.X < 551.4
						local dentroZ = posicionJugador.Z > -581.4 and posicionJugador.Z < -146.9
						local enZonaSegura = dentroX and dentroZ
						local color = Color3.fromRGB(120, 190, 255)
						local etiqueta = jugador.Name
						if enZonaSegura then
							color = Color3.fromRGB(120, 235, 190)
							etiqueta = etiqueta .. " (segura)"
						end
						if not enZonaSegura and distancia and distancia <= 30 then
							color = Color3.fromRGB(255, 90, 90)
							etiqueta = etiqueta .. " (cerca)"
						end
						table.insert(lista, {
							pos = posicionJugador,
							texto = etiqueta,
							distancia = distancia,
							color = color,
						})
					end
				end
			end

			local usados = 0
			for _, item in ipairs(lista) do
				local enPantalla, posicion = cam:WorldToViewportPoint(item.pos)
				if enPantalla and posicion.Z > 0 then
					usados = usados + 1
					local punto = EspPunto(usados)
					punto.marco.Visible = true
					punto.marco.BackgroundColor3 = item.color
					punto.marco.Position = UDim2.fromOffset(math.floor(posicion.X) - 3, math.floor(posicion.Y) - 3)
					punto.texto.Text = item.texto .. (item.distancia and ("  " .. tostring(math.floor(item.distancia)) .. " st") or "")
					punto.texto.TextColor3 = item.color
					punto.texto.Position = UDim2.fromOffset(8, -4)
				end
			end
			for i = usados + 1, #EspPuntos do
				EspPuntos[i].marco.Visible = false
			end
		end)

		-- ---------- Vuelo automático ----------
		local VueloOn = false
		local VueloBV = nil

		local function AplicarVuelo(on)
			local hrp = HRP()
			local hum = hrp and hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
			if on then
				if hum then
					pcall(function()
						hum.PlatformStand = true
						hum:ChangeState(Enum.HumanoidStateType.Freefall)
					end)
				end
			else
				if hrp then
					pcall(function()
						hrp.AssemblyLinearVelocity = Vector3.zero
						hrp.AssemblyAngularVelocity = Vector3.zero
					end)
				end
				if hum then pcall(function() hum.PlatformStand = false end) end
			end
		end

		-- Vuelo: se escribe la velocidad del HRP en cada frame (WASD + espacio/Ctrl).
		RunService.Heartbeat:Connect(function()
			if not VueloOn then return end
			local hrp = HRP()
			if not hrp then return end
			local hum = hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
			if hum and not hum.PlatformStand then
				pcall(function()
					hum.PlatformStand = true
					hum:ChangeState(Enum.HumanoidStateType.Freefall)
				end)
			end
			local cam = Workspace.CurrentCamera
			if not cam then return end
			local dir = Vector3.zero
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.yAxis end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.yAxis end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.yAxis end
			if dir.Magnitude > 0 then dir = dir.Unit * 130 end
			pcall(function()
				hrp.AssemblyLinearVelocity = dir
				hrp.AssemblyAngularVelocity = Vector3.zero
			end)
		end)

		-- ---------- chams: resaltado de jugadores a través de paredes ----------
		local COLORES_CHAM = {
			segura = Color3.fromRGB(120, 235, 190),
			cerca = Color3.fromRGB(255, 80, 80),
			normal = Color3.fromRGB(120, 190, 255),
		}

		local function chamDe(personaje)
			local existente = personaje:FindFirstChild("DreyvidCham")
			if existente and existente:IsA("Highlight") then return existente end
			local resaltado = Instance.new("Highlight")
			resaltado.Name = "DreyvidCham"
			resaltado.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			resaltado.FillTransparency = 0.55
			resaltado.OutlineTransparency = 0
			resaltado.Parent = personaje
			ChamsCreados[personaje] = resaltado
			return resaltado
		end

		task.spawn(function()
			while ScreenGui.Parent do
				task.wait(1)
				if ChamsOn then
					local yo = HRP()
					local miPos = yo and yo.Position
					local vivos = {}
					for _, jugador in ipairs(Players:GetPlayers()) do
						if jugador ~= LocalPlayer and jugador.Character then
							local hrp = jugador.Character:FindFirstChild("HumanoidRootPart")
							local hum = jugador.Character:FindFirstChildOfClass("Humanoid")
							if hrp and hum and hum.Health > 0 then
								local color = COLORES_CHAM.normal
								local pos = hrp.Position
								local enZona = pos.X > 365.3 and pos.X < 551.4 and pos.Z > -581.4 and pos.Z < -146.9
								local distancia = miPos and (pos - miPos).Magnitude or nil
								if enZona then
									color = COLORES_CHAM.segura
								elseif distancia and distancia <= 30 then
									color = COLORES_CHAM.cerca
								end
								local resaltado = chamDe(jugador.Character)
								resaltado.FillColor = color
								resaltado.OutlineColor = color:Lerp(Color3.new(1, 1, 1), 0.5)
								vivos[jugador.Character] = true
							end
						end
					end
					for personaje, resaltado in pairs(ChamsCreados) do
						if not vivos[personaje] or not personaje.Parent then
							pcall(function() resaltado:Destroy() end)
							ChamsCreados[personaje] = nil
						end
					end
				elseif next(ChamsCreados) ~= nil then
					for personaje, resaltado in pairs(ChamsCreados) do
						pcall(function() resaltado:Destroy() end)
						ChamsCreados[personaje] = nil
					end
				end
			end
		end)

