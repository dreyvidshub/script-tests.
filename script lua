				end)
			end

			if AjustesRegistrar then
			if AjustesRegistrar then
				local estadoRareza, estadoValor = 0, 0
				local function rehacerFiltro()
					if not Objetivos or not Objetivos.SetFiltro then return end
					if estadoRareza <= 0 and estadoValor <= 0 then
						Objetivos.SetFiltro("calidad", nil)
						return
					end
					Objetivos.SetFiltro("calidad", function(item)
						if estadoRareza > 0 and (item.rarityRank or 0) < estadoRareza then
							return false
						end
						if estadoValor > 0 and (item.income or 0) < estadoValor * 1e6 then
							return false
						end
						return true
					end)
				end
				AjustesRegistrar("Rareza mínima", function(valor)
					estadoRareza = tonumber(valor) or 0
					rehacerFiltro()
				end)
				AjustesRegistrar("Valor mínimo", function(valor)
					estadoValor = tonumber(valor) or 0
					rehacerFiltro()
				end)
				AjustesRegistrar("Prioridad de robo", function(valor)
					if Objetivos and Objetivos.SetPrioridad then Objetivos.SetPrioridad(valor) end
				end)
				AjustesRegistrar("Velocidad de ida", function(valor)
					local motor = Objetivos and Objetivos.Robo and Objetivos.Robo()
					if motor and motor.SetVelocidades then motor.SetVelocidades(valor, nil) end
				end)
				AjustesRegistrar("Velocidad de vuelta", function(valor)
					local motor = Objetivos and Objetivos.Robo and Objetivos.Robo()
					if motor and motor.SetVelocidades then motor.SetVelocidades(nil, valor) end
				end)
			end

				AjustesRegistrar("Anti Hit", function(on)
					AntiHitAplicar(on)
					Gestor.Panel("Anti-Hit", on)
					if on and not Gestor.Expandido() then
						Gestor.MostrarTodo()
					end
				end)
			end

			Gestor.MostrarTodo()
		end
	end

